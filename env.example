# Modele de configuration. Copier vers .env et renseigner les valeurs.
# .env est ignore par git (voir .gitignore) - ne jamais le versionner.

# Identifiants Neo4j AuraDB, affiches une seule fois a la creation de l'instance.
NEO4J_URI="neo4j+s://xxxxxxxx.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""

# Nom de la base. Les instances AuraDB recentes nomment leur base d'apres
# l'identifiant de l'instance et non "neo4j" : un "neo4j" code en dur leve
# DatabaseNotFound. Laisser vide pour utiliser la base par defaut de l'instance.
NEO4J_DATABASE=""

# Les identifiants AWS (Bedrock) ne sont PAS lus ici : ils proviennent de la
# chaine AWS habituelle (profil SSO, variables d'environnement, role d'instance).
# La region et les modeles sont configures dans graphrag/config.py.
